# Copy to config/project.env on the target machine and review every value.
# This file intentionally contains no rig-specific joint pose or calibration.
ROS_DISTRO=humble
CAN_PORT=can0
CAN_BITRATE=1000000
AUTO_ENABLE=false
USE_RVIZ=true
OBSERVE_BEFORE_GRASP=true
# Set OBSERVE_JOINTS for the actual rig after a supervised preflight.
OBSERVE_JOINTS=""
OBSERVE_SETTLE_SECONDS=2.0
OBSERVE_SLOWDOWN=1.50
PREGRASP_SLOWDOWN=1.25
ARM_SPEED_PERCENT=15
AUTO_STAGE_PAUSE=0.50
CARTESIAN_JOINT_RATE=0.10
