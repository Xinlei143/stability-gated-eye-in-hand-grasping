# Public GitHub Release containing the trained model and the calibration for
# the validated physical rig. Keep the tag and asset names immutable once
# published so a fresh machine always receives the same runtime resources.
RUNTIME_RELEASE_REPOSITORY=WillLiu322/foam-grasp-ros2
RUNTIME_RELEASE_TAG=v1.0.0
RUNTIME_RELEASE_ASSET=foam-grasp-runtime-v1.0.0.tar.gz
RUNTIME_RELEASE_CHECKSUM_ASSET=foam-grasp-runtime-v1.0.0.tar.gz.sha256
RUNTIME_MODEL_SHA256=1ecbbe59c87f075bcc1f6bb44465038ea7728bc6998beaa36f5c0a9396104a47
RUNTIME_MODEL_BYTES=504461281
RUNTIME_CALIBRATION_SHA256=570acb56f9bf06fbca8ca4e8de04c103fb4198ad64b65900aab256f179b8c65f
RUNTIME_CALIBRATION_BYTES=397

# This calibration is valid only for the camera/arm/mount combination used to
# create it. A different physical rig must publish a different profile.
RUNTIME_RIG_ID=piper-dabai-dc1-rig-01
