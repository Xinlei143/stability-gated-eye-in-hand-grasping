<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper_eye_in_hand">
  <xacro:include
    filename="$(find piper_description)/urdf/piper_description_gazebo.xacro"/>

  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.00005" ixy="0" ixz="0"
               iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.060 0.060 0.040"/>
      </geometry>
      <material name="camera_black">
        <color rgba="0.04 0.04 0.04 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.060 0.060 0.040"/>
      </geometry>
    </collision>
  </link>

  <link name="camera_color_frame"/>
  <link name="camera_color_optical_frame"/>
  <link name="camera_depth_frame"/>
  <link name="camera_depth_optical_frame"/>

  <joint name="camera_mount_joint" type="fixed">
    <parent link="link6"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0.055" rpy="0 -1.57079632679 0"/>
  </joint>

  <joint name="camera_color_frame_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_color_frame"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <joint name="camera_depth_frame_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="eye_in_hand_rgbd" type="depth">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>15</update_rate>
      <visualize>false</visualize>
      <camera name="eye_in_hand_rgbd">
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>360</height>
          <format>R8G8B8</format>
        </image>
        <depth_camera/>
        <clip>
          <near>0.05</near>
          <far>3.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.0</stddev>
        </noise>
      </camera>
      <plugin name="eye_in_hand_rgbd_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>camera</namespace>
          <remapping>eye_in_hand_rgbd/image_raw:=color/image_raw</remapping>
          <remapping>eye_in_hand_rgbd/depth/image_raw:=depth/image_raw</remapping>
          <remapping>eye_in_hand_rgbd/camera_info:=color/camera_info</remapping>
          <remapping>eye_in_hand_rgbd/depth/camera_info:=depth/camera_info</remapping>
        </ros>
        <camera_name>eye_in_hand_rgbd</camera_name>
        <frame_name>camera_color_optical_frame</frame_name>
        <min_depth>0.05</min_depth>
        <max_depth>3.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>
</robot>
