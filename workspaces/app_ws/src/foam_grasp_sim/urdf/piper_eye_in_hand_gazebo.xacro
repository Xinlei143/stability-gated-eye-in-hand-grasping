<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper_eye_in_hand">
  <xacro:include
    filename="$(find piper_description)/urdf/piper_description_gazebo.xacro"/>

  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.00005" ixy="0" ixz="0"
               iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.060 0.060 0.040"/>
      </geometry>
      <material name="camera_black">
        <color rgba="0.04 0.04 0.04 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.060 0.060 0.040"/>
      </geometry>
    </collision>
  </link>

  <link name="camera_color_frame"/>
  <link name="camera_color_optical_frame"/>
  <link name="camera_depth_frame"/>
  <link name="camera_depth_optical_frame"/>

  <joint name="camera_mount_joint" type="fixed">
    <parent link="link6"/>
    <child link="camera_link"/>
    <!-- Derived from runtime/calibration/handeye_eye_in_hand.json:
         T_link6_camera_link = T_link6_camera_optical
           * inv(T_camera_link_camera_color_optical_frame). -->
    <origin xyz="-0.0774037255 0.0095206804 0.0301674851"
            rpy="0.002600958 -1.211791754 -0.037610506"/>
  </joint>

  <joint name="camera_color_frame_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_color_frame"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <joint name="camera_depth_frame_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <!-- Explicit ODE contact settings for both Piper finger collision meshes. -->
  <gazebo reference="link7">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <maxVel>0.01</maxVel>
    <minDepth>0.001</minDepth>
    <sensor name="link7_contact_sensor" type="contact">
      <update_rate>100</update_rate>
      <contact>
        <collision>link7_collision</collision>
      </contact>
      <plugin name="link7_contact_plugin" filename="libgazebo_ros_bumper.so">
        <ros>
          <namespace>/foam_grasp_sim</namespace>
          <remapping>bumper_states:=link7_contacts</remapping>
        </ros>
        <frame_name>link7</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="link8">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <maxVel>0.01</maxVel>
    <minDepth>0.001</minDepth>
    <sensor name="link8_contact_sensor" type="contact">
      <update_rate>100</update_rate>
      <contact>
        <collision>link8_collision</collision>
      </contact>
      <plugin name="link8_contact_plugin" filename="libgazebo_ros_bumper.so">
        <ros>
          <namespace>/foam_grasp_sim</namespace>
          <remapping>bumper_states:=link8_contacts</remapping>
        </ros>
        <frame_name>link8</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="eye_in_hand_rgbd" type="depth">
      <pose>0 0 0 0 0 0</pose>
      <!-- DaBai DC1 project-validated profile: 640x480 at 30 Hz. -->
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <camera name="eye_in_hand_rgbd">
        <!-- Derived from the project-validated DC1 depth fx ~= 489.48 px. -->
        <horizontal_fov>1.158020831</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <depth_camera/>
        <clip>
          <near>0.05</near>
          <far>3.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.0</stddev>
        </noise>
      </camera>
      <plugin name="eye_in_hand_rgbd_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>camera</namespace>
          <remapping>eye_in_hand_rgbd/image_raw:=color/image_raw</remapping>
          <remapping>eye_in_hand_rgbd/depth/image_raw:=depth/image_raw</remapping>
          <remapping>eye_in_hand_rgbd/camera_info:=color/camera_info</remapping>
          <remapping>eye_in_hand_rgbd/depth/camera_info:=depth/camera_info</remapping>
        </ros>
        <camera_name>eye_in_hand_rgbd</camera_name>
        <frame_name>camera_color_optical_frame</frame_name>
        <min_depth>0.05</min_depth>
        <max_depth>3.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>
</robot>
